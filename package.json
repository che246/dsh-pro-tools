{
  "name": "dsh-pro-tools",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness desktop plugin bundle: a real Electron-main-process plugin for tray actions, plus a settings page whose switches drive it.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "tray"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./desktop/plugin.cjs": "./desktop/plugin.cjs"
  },
  "files": [
    "index.js",
    "client.js",
    "features/",
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "desktop/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "build": "node scripts/build-catalog.mjs",
    "check": "node scripts/check.mjs && node scripts/build-catalog.mjs --check",
    "hook:apply": "node desktop/apply-desktop-hook.mjs",
    "hook:check": "node desktop/apply-desktop-hook.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
